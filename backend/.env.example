# Copy to .env and fill in. Never commit .env.

# NCBI / PubMed — email is required by NCBI's usage policy.
NCBI_EMAIL=you@example.com
NCBI_API_KEY=

# Embeddings (local, downloaded from HuggingFace on first use)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM (local Ollama). Run `ollama pull llama3.2:3b` first.
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b

# RAG tuning
CHUNK_SIZE=600
CHUNK_OVERLAP=120
RAG_TOP_K=6

# Vector store (Chroma persistent directory)
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION=pubmed_chunks

# Reranker (optional). Off by default so startup stays fast.
# Turn on to run a cross-encoder over top-N chunks before feeding the LLM.
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_CANDIDATE_POOL=20
